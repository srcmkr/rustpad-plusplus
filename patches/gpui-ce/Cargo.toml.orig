[package]
name = "gpui-ce"
version = "0.3.0"
edition.workspace = true
authors = ["Nathan Sobo <nathan@zed.dev>"]
description = "A community fork of Zed's GPU-accelerated UI framework"
repository = "https://github.com/gpui-ce/gpui-ce"
publish = true
license = "Apache-2.0"
homepage = "https://gpui-ce.github.io/"
readme = "README.md"
keywords = ["desktop", "gui", "immediate"]
categories = ["gui"]
rust-version = "1.95"                                                  # required for Vec::push_mut
autobenches = false

[package.metadata.docs.rs]
# The documentation teaches testing with `TestApp`, so document it.
features = ["test-support"]

[lints]
workspace = true

[features]
default = ["font-kit", "wayland", "x11", "windows-manifest", "image-default-formats"]
# Enables the opt-in custom WGPU control API on platforms that support shared
# texture surfaces.
custom-gpu = []
wgpu-surfaces = []
test-support = [
  "leak-detection",
  "collections/test-support",
  "wayland",
  "x11",
  "proptest",
  "dep:futures-concurrency",
  "dep:postage",
  "dep:web-time",
]
bench-support = ["profiler", "dep:criterion", "dep:libc", "dep:perf-event"]
# Preserve the published feature name while consumers migrate to `bench-support`.
bench = ["bench-support"]
inspector = ["gpui_macros/inspector"]
# Tracks every entity handle so tests can assert nothing leaked. Also enabled
# by setting `GPUI_LEAK_DETECTION` when building; see `build.rs`.
leak-detection = []
font-kit = []
wayland = []
x11 = []
screen-capture = ["dep:windows-capture"]
windows-manifest = ["dep:embed-resource"]
profiler = ["dep:hdrhistogram"]
stacker = ["dep:stacksafe"]
embedded-assets = ["dep:rust-embed"]
hot-patching = ["dep:dioxus-devtools", "dep:subsecond"]
image-default-formats = ["image/default-formats"]

[lib]
name = "gpui"
path = "src/gpui.rs"
doctest = true

[dependencies]
accesskit.workspace = true
anyhow.workspace = true
async-task.workspace = true
backtrace.workspace = true
bitflags.workspace = true

collections.workspace = true
criterion = { workspace = true, optional = true }
ctor.workspace = true
derive_more = { workspace = true, features = ["add", "add_assign", "mul", "mul_assign", "not"] }
derive_setters.workspace = true
etagere.workspace = true
futures.workspace = true
futures-concurrency = { workspace = true, optional = true }
gpui_macros.workspace = true
gpui_shared_string.workspace = true
http.workspace = true
image.workspace = true
inventory.workspace = true
itertools.workspace = true
log.workspace = true
num_cpus = "1.13"
parking = "2.0.0"
parking_lot.workspace = true
palette.workspace = true
phf.workspace = true
postage = { workspace = true, features = ["blocking"], optional = true }
proptest = { workspace = true, optional = true }
chrono = { workspace = true, default-features = true }
profiling.workspace = true
rand = { workspace = true, features = ["small_rng", "thread_rng"] }
raw-window-handle.workspace = true
regex = { workspace = true, default-features = true }
refineable.workspace = true
scheduler.workspace = true
resvg = { version = "0.48.1", default-features = false, features = [
  "text",
  "system-fonts",
  "memmap-fonts",
  "raster-images",
] }
rust-embed = { version = "8.12", optional = true }
usvg = { version = "0.48.1", default-features = false }
skrifa.workspace = true
ttf-parser = "0.25"
schemars = { workspace = true, features = ["derive"] }
seahash = "4.1"
serde = { workspace = true, features = ["derive"] }
serde_json.workspace = true
slotmap.workspace = true
smallvec.workspace = true
stacksafe = { workspace = true, optional = true }
strum.workspace = true
sum_tree.workspace = true
taffy = { workspace = true, features = [
    "std",
    "flexbox",
    "grid",
    "block_layout",
    "float_layout",
] }
thiserror.workspace = true
tracing.workspace = true
gpui_util.workspace = true
unicode-segmentation.workspace = true
unicode-bidi.workspace = true
hdrhistogram = { workspace = true, optional = true }
waker-fn = "1.2.0"
lyon = "1.0"
pin-project = "1.1.10"
spin.workspace = true
url.workspace = true
uuid = { workspace = true, features = ["v4"] }
web-time = { workspace = true, optional = true }
heapless.workspace = true

[target.'cfg(all(target_arch = "wasm32", target_os = "unknown"))'.dependencies]
async-channel.workspace = true

[target.'cfg(not(all(target_arch = "wasm32", target_os = "unknown")))'.dependencies]
async-channel = { workspace = true, features = ["std"] }

[target.'cfg(target_family = "wasm")'.dependencies]
getrandom = { version = "0.3.4", features = ["wasm_js"] }
uuid = { workspace = true, features = ["js"] }

[target.'cfg(not(target_family = "wasm"))'.dependencies]
dioxus-devtools = { version = "=0.7.10", features = ["serve"], optional = true }
pollster.workspace = true
subsecond = { version = "=0.7.10", optional = true }


[target.'cfg(any(target_os = "macos", target_os = "ios"))'.dependencies]
objc2-core-foundation.workspace = true
objc2-core-video = { workspace = true, features = ["CVPixelBuffer"] }

[target.'cfg(target_os = "macos")'.dependencies]
log.workspace = true
objc2 = { workspace = true, optional = true }
objc2-metal = { version = "0.3", optional = true }

[target.'cfg(any(target_os = "linux", target_os = "android"))'.dependencies]
libc.workspace = true

[target.'cfg(unix)'.dependencies]
libc = { workspace = true, optional = true }

[target.'cfg(target_os = "linux")'.dependencies]
perf-event = { workspace = true, optional = true }


[target.'cfg(target_os = "windows")'.dependencies]
windows = { workspace = true, features = [
  "Win32_Foundation",
  "Win32_System_Power",
  "Win32_System_RemoteDesktop",
  "Win32_System_WindowsProgramming",
] }
windows-capture = { workspace = true, optional = true }
windows-061 = { workspace = true, features = ["Win32_Graphics_Direct3D11"] }


[dev-dependencies]
accesskit_consumer.workspace = true
backtrace.workspace = true
smol.workspace = true
collections = { workspace = true, features = ["test-support"] }
env_logger.workspace = true
gpui_ce_elements = { path = "../gpui_elements" }
futures-concurrency.workspace = true
postage = { workspace = true, features = ["blocking"] }
web-time.workspace = true
# Enable TestApp for doctests through the existing platform dependency. A self
# dependency would link GPUI's Windows application manifest twice in unit tests.
gpui_platform = { path = "../gpui_platform", package = "gpui_ce_platform", features = [
  "font-kit",
  "wayland",
  "x11",
  "test-support",
] }
gpui_fonts = { path = "../gpui_ce_fonts", package = "gpui-ce-fonts" }
gpui_util.workspace = true
lyon = { version = "1.0", features = ["extra"] }
rand = { workspace = true, default-features = true }
scheduler = { workspace = true, features = ["test-support"] }
image = { workspace = true, features = ["png"] }
unicode-segmentation.workspace = true

[target.'cfg(not(target_family = "wasm"))'.dev-dependencies]
proptest = { workspace = true }

[target.'cfg(target_family = "wasm")'.dev-dependencies]
wasm-bindgen.workspace = true
web-sys.workspace = true

[build-dependencies]
embed-resource = { version = "3.0", optional = true }

[package.metadata.cargo-shear]
ignored = [
  "getrandom",
  "objc2",
  "objc2-metal",
  "tracing",
]
ignored-paths = ["src/_ownership_and_data_flow.rs", "benches/focus_cleanup.rs"]


# Examples in `examples/*.rs` are discovered automatically. Benchmarks live in
# a subdirectory so they stay out of the way of the examples people read.

[[example]]
name = "data_table"
path = "examples/bench/data_table.rs"

[[example]]
name = "paths_bench"
path = "examples/bench/paths_bench.rs"

[[example]]
name = "pattern"
path = "examples/bench/pattern.rs"

[[example]]
name = "shadow"
path = "examples/bench/shadow.rs"
