[package]
name = "gpui_ce_linux"
version = "0.3.0"
description.workspace = true
edition.workspace = true
publish.workspace = true
license = "Apache-2.0"

[lints]
workspace = true

[lib]
path = "src/gpui_linux.rs"
doctest = false

[features]
default = ["wayland", "x11"]
test-support = ["gpui/test-support"]
wayland = [
  "dep:accesskit_unix",
  "dep:bitflags",
  "gpui_wgpu",
  "ashpd/wayland",
  "ashpd/inhibit",
  "calloop-wayland-source",
  "memfd",
  "wayland-backend",
  "wayland-client",
  "wayland-cursor",
  "wayland-protocols",
  "wayland-protocols-plasma",
  "wayland-protocols-wlr",
  "filedescriptor",
  "xkbcommon/wayland",
  "open",
  "gpui/wayland",
  "uuid/v5",
]
x11 = [
  "dep:accesskit_unix",
  "gpui_wgpu",
  "ashpd",
  "ashpd/inhibit",
  "as-raw-xcb-connection",
  "x11rb",
  "xkbcommon/x11",
  "xim",
  "x11-clipboard",
  "filedescriptor",
  "open",
  "scap?/x11",
]
screen-capture = ["gpui/screen-capture", "dep:scap"]

[target.'cfg(any(target_os = "linux", target_os = "freebsd"))'.dependencies]
accesskit.workspace = true
accesskit_unix = { workspace = true, optional = true }
anyhow.workspace = true
bytemuck.workspace = true
collections.workspace = true
image.workspace = true
futures.workspace = true
gpui = { workspace = true, default-features = false }
gpui_util.workspace = true
gpui_parley = { workspace = true, features = ["system-fonts"] }
gpui_wgpu = { workspace = true, optional = true }
itertools.workspace = true
libc.workspace = true
log.workspace = true
parking_lot.workspace = true
smallvec.workspace = true
smol.workspace = true
strum.workspace = true
url.workspace = true
uuid.workspace = true

# Always used
oo7 = { workspace = true, features = [
  "async-std",
  "native_crypto",
] }
calloop = "0.14.3"
notify-rust.workspace = true
raw-window-handle.workspace = true

# Used in both windowing options
bitflags = { workspace = true, optional = true }
ashpd = { workspace = true, optional = true }
filedescriptor = { version = "0.8.2", optional = true }
open = { version = "5.2.0", optional = true }
xkbcommon = { workspace = true, optional = true }

# Screen capture
scap = { workspace = true, optional = true }

# Wayland
calloop-wayland-source = { version = "0.4.1", optional = true }
memfd = { version = "0.6.5", optional = true }
wayland-backend = { version = "0.3.15", features = [
  "client_system",
  "dlopen",
  "log",
], optional = true }
wayland-client = { version = "0.31.11", optional = true }
wayland-cursor = { version = "0.31.11", optional = true }
wayland-protocols = { version = "0.32.9", features = [
  "client",
  "staging",
  "unstable",
], optional = true }
wayland-protocols-plasma = { version = "0.3.9", features = [
  "client",
], optional = true }
wayland-protocols-wlr = { version = "0.3.9", features = [
  "client",
], optional = true }

# X11
as-raw-xcb-connection = { version = "1", optional = true }
x11rb = { version = "0.13.1", features = [
  "allow-unsafe-code",
  "xkb",
  "randr",
  "xinput",
  "cursor",
  "resource_manager",
  "sync",
  "dri3",
], optional = true }
xim = { version = "0.4.0-zed", package = "zed-xim", features = [
  "x11rb-xcb",
  "x11rb-client",
], optional = true }
x11-clipboard = { version = "0.9.3", optional = true }

[target.'cfg(any(target_os = "linux", target_os = "freebsd"))'.dev-dependencies]
gpui = { workspace = true, features = ["test-support"] }

[package.metadata.cargo-shear]
ignored = ["scap"]
